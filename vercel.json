{
    "version":2,
    "build":[
        {
            "src":"greatkart/wsgi.py",
            "use":"@vercel/python",
            "config":{"maxlambdaSize":"15mb", "runtime":"python3.10.1"}
        },
        {
            "src":"build_files.sh",
            "use":"@vercel/static-build",
            "config":{"distDir":"staticfiles_build"}

        }
    ],
    "routes":[
        {
            "src":"/static/(.*)",
            "dest":"/static/$1"
        },
        {
            "src":"/(.*)",
            "dest":"greatkart/wsgi.py"
        }
    ]
}